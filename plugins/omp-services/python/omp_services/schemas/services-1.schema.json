{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/saadsoft1993/omp-tether/plugins/omp-services/python/omp_services/schemas/services-1.schema.json",
	"title": "services/1 drop-in",
	"description": "$XDG_CONFIG_HOME/omp-services/services.d/<plugin>.json. Specification: docs/protocol/services-1.md.",
	"type": "object",
	"additionalProperties": false,
	"required": ["protocol", "plugin", "services"],
	"properties": {
		"protocol": { "const": "services/1" },
		"plugin": { "$ref": "#/$defs/plugin" },
		"services": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/service" } }
	},
	"$defs": {
		"plugin": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$" },
		"absPath": { "type": "string", "pattern": "^/[^\\x00-\\x1f]*$", "maxLength": 1024 },
		"args": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[^\\x00-\\x1f]*$", "maxLength": 1024 } },
		"service": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "program"],
			"properties": {
				"name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
				"description": { "type": "string", "pattern": "^[^\\x00-\\x1f]*$", "maxLength": 200 },
				"program": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["type", "script"],
							"properties": {
								"type": { "const": "omp-script" },
								"script": { "$ref": "#/$defs/absPath" },
								"args": { "$ref": "#/$defs/args" }
							},
							"description": "A TypeScript or JavaScript file run by the pinned omp's embedded Bun (BUN_BE_BUN=1)."
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["type", "script"],
							"properties": {
								"type": { "const": "python" },
								"script": { "$ref": "#/$defs/absPath" },
								"args": { "$ref": "#/$defs/args" }
							},
							"description": "A Python script run by the Python 3.10+ that init pinned."
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["type", "argv"],
							"properties": {
								"type": { "const": "exec" },
								"argv": {
									"type": "array",
									"minItems": 1,
									"maxItems": 33,
									"items": { "type": "string", "pattern": "^[^\\x00-\\x1f]*$", "maxLength": 1024 }
								}
							},
							"description": "A program given by absolute path (argv[0], checked by the renderer) and its arguments."
						}
					]
				},
				"env": {
					"type": "object",
					"additionalProperties": { "type": "string", "pattern": "^[^\\x00-\\x1f]*$", "maxLength": 1024 },
					"description": "Non-secret environment. Names must be ^[A-Z_][A-Z0-9_]*$ (checked by the renderer). Secrets belong in 0600 files the service reads itself."
				},
				"workingDirectory": { "$ref": "#/$defs/absPath" },
				"protected": {
					"type": "boolean",
					"default": false,
					"description": "Never reloaded or restarted by init or a watchdog unless the user asks by name."
				},
				"throttleSeconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 10 }
			}
		}
	}
}
