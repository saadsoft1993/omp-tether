	<array>
		<string>/usr/bin/python3.12</string>
		<string>/home/example/.local/share/omp-services/current/python/omp_services_main.py</string>
		<string>heartbeat</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
