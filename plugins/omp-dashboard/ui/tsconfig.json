{
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "ES2024",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": false
	},
	"include": ["src", "tests", "build.ts"]
}
