+/**
+ * Private relay: hosts reach it on a loopback `ws://` listener, so their links
+ * name that private address. A page served by the relay's own guest listener
+ * connects back to its own origin instead: `wss://` when the page is https
+ * (behind `tailscale serve`), `ws://` when it is plain http on a loopback
+ * address (the relay's `token` adapter).
+ */
+function guestRelayOrigin(origin: string): string {
+	if (typeof location === "undefined") return origin;
+	const url = new URL(origin);
+	if (url.protocol !== "ws:" || !LOCAL_HOSTNAMES[url.hostname]) return origin;
+	if (location.protocol === "https:") return `wss://${location.host}`;
+	if (location.protocol === "http:" && LOCAL_HOSTNAMES[location.hostname]) return `ws://${location.host}`;
+	return origin;
+}
